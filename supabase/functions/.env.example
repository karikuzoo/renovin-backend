# Salin menjadi supabase/functions/.env untuk menjalankan function secara lokal.
# Untuk project cloud: npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL dan SUPABASE_ANON_KEY sudah disediakan otomatis oleh Supabase.

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_ROOT_FOLDER=/renovin/dev
ALLOWED_ORIGINS=http://localhost:3000

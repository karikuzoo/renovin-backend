{
  "name": "renovin-backend",
  "version": "1.0.0",
  "description": "Konfigurasi Supabase untuk Renovin: migration, RLS, seed, edge functions",
  "scripts": {
    "migration:new": "supabase migration new",
    "migration:list": "supabase migration list",
    "push:dev": "supabase db push",
    "push:dev:seed": "supabase db push --include-seed",
    "types": "supabase gen types --lang typescript --linked --schema public > types/database.types.ts",
    "functions:deploy": "supabase functions deploy --use-api",
    "secrets:set": "supabase secrets set --env-file supabase/functions/.env"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "supabase": "^2.119.0"
  },
  "private": true
}
